# Database driver and connection settings.
# SQLite only needs these two values:
DB_CONNECTION=sqlite
DB_DATABASE=./db/sqlite.db

# MySQL example:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=beaver
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL example:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=beaver
# DB_USERNAME=postgres
# DB_PASSWORD=

# Filled with the initial credentials by the Beaver project initializer.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
SESSION_SECRET=
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=

# Admin panel URL segment and media storage directory.
ADMIN_PATH=admin
STORAGE_TYPE=local
STORAGE_PATH=./public/storage
# UPLOAD_DIR is the legacy parent directory fallback for existing projects.
UPLOAD_DIR=./public

# AWS S3 storage. Used only when STORAGE_TYPE=s3.
# S3_REGION=us-east-1
# S3_BUCKET=my-beaver-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Enable only when the trusted proxy overwrites forwarded-IP headers.
TRUST_PROXY=false

# Cloudflare Turnstile. Keep CONTACT_TURNSTILE_REQUIRED=false for local development.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_TURNSTILE_REQUIRED=false

# Optional SMTP delivery for the public contact form.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional filesystem cache for public data.
PUBLIC_CACHE_DIR=
PUBLIC_CACHE_TTL_SECONDS=
