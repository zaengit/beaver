# SQLite database location, relative to the consuming project.
DATABASE_URL=./db/sqlite.db

# Replaced with unique credentials when generated by `npx @zbeaver/beaver config`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Super Admin
SESSION_SECRET=change-me
ADMIN_JWT_ACCESS_SECRET=change-me
ADMIN_JWT_REFRESH_SECRET=change-me

# Admin panel URL segment and public media root.
ADMIN_PATH=admin
UPLOAD_DIR=./public

# Enable only when the trusted proxy overwrites forwarded-IP headers.
TRUST_PROXY=false

# Cloudflare Turnstile. Keep CONTACT_TURNSTILE_REQUIRED=false for local development.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_TURNSTILE_REQUIRED=false

# Optional SMTP delivery for the public contact form.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional filesystem cache for public data.
PUBLIC_CACHE_DIR=
PUBLIC_CACHE_TTL_SECONDS=
