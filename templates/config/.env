# Database
DATABASE_URL=./db/sqlite.db

# Auth
SESSION_SECRET=

ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=

# Initial Super Admin (used by seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password123
ADMIN_NAME=Super Admin

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public path for the admin UI. Use one URL segment; the default is /admin.
# Set a private, hard-to-guess value in production, e.g. ADMIN_PATH=panel-7xk9
ADMIN_PATH=admin
# JSON registry paths, relative to the project root or absolute.
SECTION_REGISTRY_PATH=src/components/web/sections/registry.json
CONTENT_TYPE_REGISTRY_PATH=src/components/web/content-type-templates/registry.json

# Upload directory
UPLOAD_DIR=./public

# Contact email (SMTP)
# Set SMTP_SECURE=true for port 465; use false for STARTTLS ports such as 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile for the public contact form.
# The site key is public; keep the secret key private and never prefix it with PUBLIC_.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_TURNSTILE_REQUIRED=false
