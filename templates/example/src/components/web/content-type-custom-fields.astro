---
interface Field {
  label: string
  type: string
  value: unknown
}

interface Props {
  fields: Field[]
}

const { fields } = Astro.props
const formatValue = (value: unknown) => value === true ? "Yes" : value === false ? "No" : String(value)
---

{fields.length > 0 && (
  <section class="mx-auto max-w-6xl px-6 pb-16 sm:pb-20">
    <dl class="grid gap-px overflow-hidden rounded-sm border border-slate-200 bg-slate-200 sm:grid-cols-2">
      {fields.map((field) => (
        <div class="bg-white px-5 py-4">
          <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">{field.label}</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-950">
            {field.type === "image" && typeof field.value === "string"
              ? <img src={field.value} alt={field.label} class="max-h-64 w-full rounded-sm object-cover" loading="lazy" />
              : formatValue(field.value)}
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}
