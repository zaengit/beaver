---
import SectionHeading from "./shared/section-heading.astro"
const { section, contentItems = [] } = Astro.props as any
---
<section id={section.style_id || undefined} class:list={["py-20", section.style_css]}><div class="mx-auto max-w-4xl px-6"><SectionHeading content={section} /><div class="mt-10 space-y-5">{contentItems.map((post: any) => <article class="border-b pb-5"><h3 class="text-xl font-semibold"><a href={`/${post.type}/${post.slug}`}>{post.title}</a></h3>{post.excerpt && <p class="mt-2 text-slate-600">{post.excerpt}</p>}</article>)}</div></div></section>
