---
import { getSectionStyle, type Section } from "./shared/types"
import ResponsiveImage from "@/components/web/responsive-image.astro"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<section id={section.style_id || undefined} class:list={["border-b border-slate-100", section.style_css]}>
  {(section.item ?? []).map((item) => (
    <article class="relative isolate overflow-hidden bg-slate-900 px-6 py-12 text-white sm:py-16" style={getSectionStyle({ ...section, bg_color: item.bg_color || section.bg_color, bg_image: item.bg_image || section.bg_image })}>
      {item.image && <ResponsiveImage src={item.image} alt={item.alt_image || item.title || ""} class="absolute inset-0 -z-20 h-full w-full object-cover opacity-40" />}
      <div class="absolute inset-0 -z-10 bg-slate-950/55" />
      <div class="mx-auto flex max-w-7xl flex-col items-start gap-5 sm:flex-row sm:items-center sm:justify-between">
        <div class="max-w-3xl">
          <SectionHeading content={item} />
        </div>
        {item.links?.[0]?.label && item.links[0]?.url && <a href={item.links[0].url} class="shrink-0 rounded-sm bg-white px-4 py-2.5 text-sm font-semibold text-slate-950 hover:bg-slate-200">{item.links[0].label}</a>}
      </div>
    </article>
  ))}
</section>
