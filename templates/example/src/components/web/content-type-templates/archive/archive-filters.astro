---
import type { PublicArchiveFilterOptions, PublicArchiveFilters } from "@/shared/types/posts"

interface Props {
  contentType: { slug: string }
  filterOptions: PublicArchiveFilterOptions
  filters: PublicArchiveFilters
}

const { contentType, filterOptions, filters } = Astro.props
const isFiltered = Boolean(filters.search || filters.category || filters.tag || Object.keys(filters.customFields ?? {}).length > 0)
---

<form action={`/${contentType.slug}`} method="get" class="mt-8 grid gap-3 border border-slate-200 bg-slate-50 p-4 sm:grid-cols-2 lg:grid-cols-4">
  <div>
    <label class="mb-1.5 block text-sm font-medium text-slate-700" for="archive-search">Search</label>
    <input id="archive-search" name="search" value={filters.search ?? ""} type="search" placeholder="Search..." class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 outline-none focus:border-slate-950 focus:ring-1 focus:ring-slate-950" />
  </div>
  {filterOptions.customFields.map((field) => (
    <div>
      <label class="mb-1.5 block text-sm font-medium text-slate-700" for={`field-${field.name}`}>{field.label}</label>
      {field.type === "select" ? (
        <select id={`field-${field.name}`} name={`field_${field.name}`} class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 outline-none focus:border-slate-950 focus:ring-1 focus:ring-slate-950">
          <option value="">All {field.label}</option>
          {field.options.map((option) => <option value={option} selected={filters.customFields?.[field.name] === option}>{option}</option>)}
        </select>
      ) : field.type === "boolean" ? (
        <select id={`field-${field.name}`} name={`field_${field.name}`} class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 outline-none focus:border-slate-950 focus:ring-1 focus:ring-slate-950">
          <option value="">All {field.label}</option>
          <option value="true" selected={filters.customFields?.[field.name] === "true"}>Yes</option>
          <option value="false" selected={filters.customFields?.[field.name] === "false"}>No</option>
        </select>
      ) : (
        <input id={`field-${field.name}`} name={`field_${field.name}`} value={filters.customFields?.[field.name] ?? ""} type={field.type === "date" ? "date" : field.type === "number" ? "number" : "search"} placeholder={`Filter by ${field.label}`} class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 outline-none focus:border-slate-950 focus:ring-1 focus:ring-slate-950" />
      )}
    </div>
  ))}
  <div>
    <label class="mb-1.5 block text-sm font-medium text-slate-700" for="archive-category">Category</label>
    <select id="archive-category" name="category" class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 outline-none focus:border-slate-950 focus:ring-1 focus:ring-slate-950">
      <option value="">All categories</option>
      {filterOptions.categories.map((category) => <option value={category.slug} selected={filters.category === category.slug}>{category.name}</option>)}
    </select>
  </div>
  <div>
    <label class="mb-1.5 block text-sm font-medium text-slate-700" for="archive-tag">Tag</label>
    <select id="archive-tag" name="tag" class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-950 outline-none focus:border-slate-950 focus:ring-1 focus:ring-slate-950">
      <option value="">All tags</option>
      {filterOptions.tags.map((tag) => <option value={tag} selected={filters.tag?.toLowerCase() === tag.toLowerCase()}>{tag}</option>)}
    </select>
  </div>
  <div class="flex items-end gap-3">
    <button class="bg-slate-950 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">Apply filters</button>
    {isFiltered && <a href={`/${contentType.slug}`} class="py-2 text-sm font-semibold text-slate-600 hover:text-slate-950">Clear</a>}
  </div>
</form>
