---
import type { Post } from "@/shared/types/posts"
import PageSections from "@/components/web/page-sections.astro"

interface Props { page: Post & { authorName: string | null } }
const { page } = Astro.props
---

<main>
  {page.description && <div class="prose prose-slate mx-auto max-w-3xl px-6 py-12 sm:py-16" set:html={page.description} />}
  <PageSections sections={page.sections} />
</main>
