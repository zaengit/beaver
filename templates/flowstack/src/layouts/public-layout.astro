---
import "@/styles/public.css"
import { Footer } from "@/components/footer.tsx"
import { Navbar } from "@/components/navbar.tsx"
import { getMenuTree, getSiteSettings } from "@zbeaver/beaver/server"
import { safeImageSrc } from "@/components/safe-url"

interface Props {
  title?: string
  description?: string | null
}

const { title = "CMS", description } = Astro.props
const settings = await getSiteSettings()
const [navbarResult, footerResult] = await Promise.all([getMenuTree("navbar"), getMenuTree("footer")])
const navbarItems = navbarResult.success ? navbarResult.data : []
const footerItems = footerResult.success ? footerResult.data : []
const favicon = safeImageSrc(settings.favicon)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {(description || settings.meta_description) && <meta name="description" content={description || settings.meta_description} />}
    {favicon && <link rel="icon" href={favicon} />}
  </head>
  <body class="min-h-screen bg-[var(--bg)] text-[var(--ink)]">
    <div class="flex min-h-screen flex-col">
      <Navbar items={navbarItems as never[]} siteName={settings.title} logo={settings.logo} client:load />
      <div class="flex-1"><slot /></div>
      <Footer
        items={footerItems as never[]}
        siteName={settings.title}
        description={settings.description}
        socialLinks={settings.links}
        openHours={settings.open_hours}
        translateCountries={settings.translate_countries}
      />
    </div>
    {settings.translate_countries.length > 0 && (
      <>
        <script is:inline define:vars={{ translateCountries: settings.translate_countries }}>
          window.googleTranslateElementInit = function () {
            const element = document.getElementById("google_translate_element")
            if (!element || element.dataset.googleTranslateInitialized === "true") return

            const translateApi = window.google?.translate
            if (!translateApi?.TranslateElement) {
              window.setTimeout(window.googleTranslateElementInit, 100)
              return
            }

            new translateApi.TranslateElement(
              {
                pageLanguage: "en",
                includedLanguages: translateCountries.join(","),
                autoDisplay: false,
              },
              "google_translate_element",
            )
            element.dataset.googleTranslateInitialized = "true"
          }
          window.setTimeout(window.googleTranslateElementInit, 0)
        </script>
        <script is:inline type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
      </>
    )}
  </body>
</html>
