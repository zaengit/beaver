---
import PublicLayout from "@/layouts/public-layout.astro"
import PublicPage from "@/components/public-page.astro"
import { getPublishedPostByType } from "@zbeaver/beaver/server"

const homeResult = await getPublishedPostByType("page", "home")
const home = homeResult.success ? homeResult.data : null

if (!home) {
  return new Response("Home page not found", { status: 404 })
}
---

<PublicLayout title={home.metaTitle || home.title} description={home.metaDescription}>
  <PublicPage page={home} />
</PublicLayout>
