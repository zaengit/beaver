---
import ContentTypeDetail from "@/components/content-type-detail.astro"
import PublicLayout from "@/layouts/public-layout.astro"
import { contentTypeRegistry as registry } from "@/shared/registry"
import { getPublishedPostByType } from "@zbeaver/beaver/server"

const { type, slug } = Astro.params
const contentType = type ? registry.contentTypes.find((candidate) => candidate.slug === type) ?? null : null

if (!contentType || !slug) {
  return new Response("Content type not found", { status: 404 })
}

const postResult = await getPublishedPostByType(contentType.slug, slug)
if (!postResult.success) {
  return new Response("Post not found", { status: 404 })
}
---

<PublicLayout title={postResult.data.metaTitle || postResult.data.title}>
  <ContentTypeDetail contentType={contentType} post={postResult.data} />
</PublicLayout>
