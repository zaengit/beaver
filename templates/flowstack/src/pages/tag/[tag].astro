---
import PublicLayout from "@/layouts/PublicLayout.astro"
import { listPublishedPostsByTag } from "@zbeaver/beaver/server"

const encodedTag = Astro.params.tag ?? ""
let tag = ""

try {
  tag = decodeURIComponent(encodedTag).trim().slice(0, 100)
} catch {
  return new Response("Tag not found", { status: 404 })
}

if (!tag) return new Response("Tag not found", { status: 404 })

const result = listPublishedPostsByTag(tag, 1, 24)
const posts = result.success ? result.data.data : []

function publicUrl(post: { type: string; slug: string }) {
  if (post.type === "page") return post.slug === "home" ? "/" : `/${post.slug}`
  return `/${post.type}/${post.slug}`
}
---

<PublicLayout title={`Tag: ${tag}`}>
  <main class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Tag</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">{tag}</h1>
    <p class="mt-5 text-slate-600">{result.success ? result.data.meta.total : 0} published item{result.success && result.data.meta.total === 1 ? "" : "s"}</p>

    {posts.length > 0 ? (
      <div class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
        {posts.map((post) => (
          <article class="py-6">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">{post.type}</p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-950">
              <a href={publicUrl(post)} class="hover:underline">{post.title}</a>
            </h2>
            {post.excerpt && <p class="mt-2 leading-7 text-slate-600">{post.excerpt}</p>}
          </article>
        ))}
      </div>
    ) : (
      <p class="mt-10 text-slate-600">No published content has this tag yet.</p>
    )}
  </main>
</PublicLayout>
