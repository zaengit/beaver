---
import type { ArchiveProps, ArchiveTemplateVariant } from "../types"

interface Props {
  contentType: ArchiveProps["contentType"]
  variant: ArchiveTemplateVariant
}

const { contentType, variant } = Astro.props
const styles = {
  default: {
    header: "pb-8",
    title: "mt-3 max-w-3xl text-[36px] font-black leading-none tracking-[-0.04em] text-[var(--ink)] sm:text-[56px]",
    description: "mt-4 max-w-2xl text-[15px] leading-7 text-[var(--muted)]",
  },
  "post-grid": {
    header: "pb-8 sm:pb-10",
    title: "mt-4 text-4xl font-black leading-none tracking-[-0.05em] text-slate-950 sm:text-6xl",
    description: "mt-4 max-w-2xl text-base leading-7 text-slate-500",
  },
} as const
const style = styles[variant]
---

<header class={style.header}>
  {variant === "default" ? (
    <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]">{contentType.slug} — archive</p>
  ) : (
    <div class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.16em] text-indigo-600">
      <span class="h-2 w-2 rounded-full bg-indigo-600" aria-hidden="true"></span>
      <span>{contentType.label}</span>
    </div>
  )}
  <h1 class={style.title}>{contentType.label}</h1>
  {contentType.description && <p class={style.description}>{contentType.description}</p>}
</header>
