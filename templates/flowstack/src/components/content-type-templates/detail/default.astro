---
import { parseGallery, type DetailProps } from "../types"
import PostContent from "./post-content.astro"
import TagLinks from "@/components/tag-links.astro"
import { safeContentArchiveHref } from "../../safe-url"
const { contentType, post } = Astro.props as DetailProps
const gallery = parseGallery(post.gallery)
---

<main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
  <a
    href={safeContentArchiveHref(contentType.slug)}
    class="inline-flex items-center gap-2 border border-[var(--line-strong)] bg-[var(--paper)] px-4 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--ink)] hover:bg-[var(--bg)]"
  >
    ← All {contentType.label}
  </a>

  <article class="mt-8">
    <header class="border-b border-[var(--line-strong)] pb-8">
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]">{contentType.label}</p>
      <h1 class="mt-3 max-w-3xl text-[36px] font-black leading-none tracking-[-0.04em] text-[var(--ink)] sm:text-[56px]">
        {post.title}
      </h1>
      {post.excerpt && (
        <p class="mt-4 max-w-2xl text-[16px] leading-7 text-[var(--muted)]">{post.excerpt}</p>
      )}
    </header>

    <TagLinks tags={post.tags} />

    <PostContent {post} {gallery} variant="default" />
  </article>
</main>
