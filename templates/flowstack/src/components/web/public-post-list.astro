---
import type { PublicPost } from "@/shared/types/posts"
import { publicPostHref } from "./public-url"

type PostListItem = Pick<PublicPost, "type" | "slug" | "title" | "excerpt">

interface Props {
  posts: PostListItem[]
  listClass: string
  showDetails?: boolean
  emptyMessage?: string
  emptyClass?: string
}

const {
  posts,
  listClass,
  showDetails = false,
  emptyMessage,
  emptyClass = "mt-10 text-slate-600",
} = Astro.props
---

{posts.length > 0 ? (
  <div class={listClass}>
    {posts.map((post) => {
      const href = publicPostHref(post)

      return (
        <article class="py-6">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">{post.type}</p>
          <h2 class="mt-2 text-2xl font-semibold tracking-tight text-slate-950">
            <a href={href} class="hover:underline">{post.title}</a>
          </h2>
          {post.excerpt && <p class="mt-2 leading-7 text-slate-600">{post.excerpt}</p>}
          {showDetails && (
            <a href={href} class="mt-3 inline-flex text-sm font-semibold text-slate-950 underline-offset-4 hover:underline">
              View details
            </a>
          )}
        </article>
      )
    })}
  </div>
) : emptyMessage ? (
  <p class={emptyClass}>{emptyMessage}</p>
) : null}
