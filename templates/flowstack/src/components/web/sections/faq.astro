---
import { getSectionStyle, type Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <section
    id={section.style_id || undefined}
    class:list={[
      "border border-[var(--line-strong)] bg-[var(--paper)] px-6 py-10 sm:px-10 sm:py-12",
      section.style_css
    ]}
    style={getSectionStyle(section)}
  >
    <div class="mx-auto max-w-4xl">
      <SectionHeading content={section} theme="light" />
      <div class="mt-8 divide-y divide-[var(--line-strong)] border-y border-[var(--line-strong)]">
        {(section.item ?? []).map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[15px] font-bold leading-tight text-[var(--ink)]">
              <span>{item.question}</span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center border border-[var(--line-strong)] text-[14px] font-black leading-none group-open:bg-[var(--ink)] group-open:text-white">
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">—</span>
              </span>
            </summary>
            {item.answer && (
              <p class="mt-3 max-w-3xl whitespace-pre-line border-l-2 border-[var(--line-strong)] pl-4 text-[14px] leading-6 text-[var(--muted)]">
                {item.answer}
              </p>
            )}
          </details>
        ))}
      </div>
    </div>
  </section>
</div>
