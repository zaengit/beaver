---
import type { Section, SectionItem } from "./types"

interface Props {
  content: Pick<Section | SectionItem, "caption" | "title" | "text">
  theme?: "dark" | "light"
}

const { content, theme = "dark" } = Astro.props
const isLight = theme === "light"
---

{content.caption && (
  <div class="mb-4">
    <span class:list={[
      "text-xs font-semibold uppercase tracking-[0.14em]",
      isLight ? "text-[#1769f5]" : "text-white"
    ]}>
      {content.caption}
    </span>
  </div>
)}
{content.title && (
  <h2 class:list={[
    "mx-auto max-w-4xl text-3xl font-bold leading-[1.08] tracking-[-0.04em] sm:text-4xl",
    isLight ? "text-slate-950" : "text-white"
  ]}>
    {content.title}
  </h2>
)}
{content.text && (
  <p class:list={[
    "mx-auto mt-4 max-w-2xl text-[15px] leading-7",
    isLight ? "text-slate-600" : "text-indigo-100/75"
  ]}>
    {content.text}
  </p>
)}
