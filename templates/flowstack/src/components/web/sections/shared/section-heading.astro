---
import type { Section, SectionItem } from "./types"

interface Props {
  content: Pick<Section | SectionItem, "caption" | "title" | "text">
  theme?: "dark" | "light"
}

const { content, theme = "dark" } = Astro.props
const isLight = theme === "light"
---

{content.caption && (
  <div class="mb-4">
    <span class:list={[
      "inline-flex items-center gap-2 border-b-2 pb-1 text-[11px] font-bold uppercase tracking-[0.16em]",
      isLight ? "border-[var(--line-strong)] text-[var(--ink)]" : "border-white text-white"
    ]}>
      <span class:list={["h-1 w-1", isLight ? "bg-[var(--ink)]" : "bg-white"]} aria-hidden="true"></span>
      {content.caption}
    </span>
  </div>
)}
{content.title && (
  <h2 class:list={[
    "mx-auto max-w-4xl text-[30px] font-black leading-[0.95] tracking-[-0.04em] sm:text-[44px]",
    isLight ? "text-[var(--ink)]" : "text-white"
  ]}>
    {content.title}
  </h2>
)}
{content.text && (
  <p class:list={[
    "mx-auto mt-4 max-w-2xl text-[15px] leading-7",
    isLight ? "text-[var(--muted)]" : "text-white/75"
  ]}>
    {content.text}
  </p>
)}
