---
import { getSafeLinks } from "../safe-url"
import { getSectionStyle, type Section } from "./shared/types"
import ResponsiveImage from "@/components/web/responsive-image.astro"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 sm:py-12">
  <section
    id={section.style_id || undefined}
    class:list={[
      "overflow-hidden bg-[#0b1020]",
      section.style_css
    ]}
    aria-label={section.title || "Feature highlights"}
  >
    <div class="flex snap-x snap-mandatory overflow-x-auto">
      {(section.item ?? []).map((item, idx) => {
        const links = getSafeLinks(item.links)

        return (
        <article
          class="relative flex min-h-[30rem] min-w-full snap-start flex-col justify-between sm:min-h-[36rem]"
          style={getSectionStyle({ ...section, bg_color: item.bg_color || section.bg_color, bg_image: item.bg_image || section.bg_image })}
        >
          {item.image && (
            <ResponsiveImage
              src={item.image}
              alt={item.alt_image || item.title || ""}
              class="absolute inset-0 h-full w-full object-cover"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-br from-[#0b1020]/95 via-[#0b1020]/65 to-indigo-950/60"></div>
          <div class="relative flex h-full flex-col justify-between p-6 text-white sm:p-10 lg:p-14">
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-[0.14em] text-indigo-100/70">
              <span aria-hidden="true">{String(idx + 1).padStart(2, "0")} / {(section.item ?? []).length.toString().padStart(2, "0")}</span>
              <span class="hidden h-px w-20 bg-white/20 sm:block"></span>
            </div>
            <div class:list={[
              "mt-8 max-w-3xl",
              section.alignment === "center" && "mx-auto text-center",
              section.alignment === "right" && "ml-auto text-right"
            ]}>
              <SectionHeading content={item} theme="dark" />
              {links.length > 0 ? (
                <div class:list={[
                  "mt-6 flex flex-wrap gap-3",
                  section.alignment === "center" && "justify-center",
                  section.alignment === "right" && "justify-end"
                ]}>
                  {links.map((link) => (
                    <a
                      href={link.href}
                      class="inline-flex items-center justify-center rounded-full border border-white/20 bg-white px-5 py-3 text-xs font-bold text-[#0b1020] hover:bg-indigo-50"
                    >
                      {link.label} <span class="ml-2" aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              ) : null}
            </div>
          </div>
        </article>
        )
      })}
    </div>
  </section>
</div>
