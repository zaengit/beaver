---
import { getSectionStyle, safeHref, type Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <section
    id={section.style_id || undefined}
    class:list={[
      "border border-[var(--line-strong)] bg-[var(--ink)] px-6 py-10 text-white sm:px-10 sm:py-12",
      section.style_css
    ]}
    style={getSectionStyle(section)}
  >
    <div class:list={["max-w-6xl", section.alignment === "center" && "text-center", section.alignment === "right" && "text-right"]}>
      <SectionHeading content={section} theme="dark" />
      <div class="mt-10 grid gap-0 divide-y divide-white/15 border-t border-white/15 sm:grid-cols-2 sm:divide-y-0 sm:divide-x lg:grid-cols-3">
        {(section.item ?? []).map((item) => (
          <article class="p-6 sm:p-7">
            {item.icon && (
              <div class="mb-4 inline-flex border border-white/20 bg-white/5 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-white">
                {item.icon}
              </div>
            )}
            {item.title && <h3 class="text-[17px] font-bold leading-tight tracking-[-0.02em] text-white">{item.title}</h3>}
            {item.text && <p class="mt-2 text-[14px] leading-6 text-white/70">{item.text}</p>}
            {item.links?.[0]?.label && safeHref(item.links[0]?.url) !== "#" && (
              <div class="mt-4">
                <a
                  href={safeHref(item.links[0].url)}
                  class="inline-flex items-center gap-2 border-b border-white/30 pb-1 text-[11px] font-bold uppercase tracking-[0.14em] text-white hover:border-white"
                >
                  {item.links[0].label} <span aria-hidden="true">→</span>
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</div>
