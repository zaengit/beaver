---
import type { PublicPost } from "@/shared/types/posts"
import type { Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"
import PostCard from "../post-card.astro"
import { safeContentHref } from "../safe-url"

interface Props {
  section: Section
  contentItems?: PublicPost[]
}

const { section, contentItems = [] } = Astro.props as Props
---

<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 sm:py-12">
  <section id={section.style_id || undefined} class:list={[section.style_css]}>
    <div class="flex flex-col gap-8">
      <div class="text-center">
        <SectionHeading content={section} theme="light" />
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {contentItems.map((post) => (
          <PostCard post={post} href={safeContentHref(post.type, post.slug)} variant="section" />
        ))}
      </div>
      {contentItems.length === 0 && (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
          <p class="text-sm font-semibold text-slate-500">No published content yet.</p>
        </div>
      )}
    </div>
  </section>
</div>
