---
import type { PublicPost } from "@/shared/types/posts"
import type { Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"
import { safeContentHref } from "../safe-url"

interface Props {
  section: Section
  contentItems?: PublicPost[]
}

const { section, contentItems = [] } = Astro.props as Props
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 my-6">
  <section id={section.style_id || undefined} class:list={["rounded-[32px] sm:rounded-[40px] border border-slate-200/90 bg-slate-50/80 p-8 sm:p-16 shadow-xl", section.style_css]}>
    <div class="mx-auto max-w-7xl">
      <SectionHeading content={section} theme="light" />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {contentItems.map((post) => (
          <article class="rounded-[24px] border border-slate-200/80 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:border-indigo-300 hover:shadow-xl group flex flex-col justify-between">
            <div>
              <h3 class="text-xl font-bold tracking-tight text-slate-950 transition-colors group-hover:text-indigo-600">
                <a href={safeContentHref(post.type, post.slug)} class="focus:outline-none">
                  {post.title}
                </a>
              </h3>
              {post.excerpt && <p class="mt-3 text-sm leading-relaxed text-slate-600 font-normal line-clamp-3">{post.excerpt}</p>}
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100">
              <a
                href={safeContentHref(post.type, post.slug)}
                class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200/80 px-4 py-2 text-xs font-bold text-indigo-700 transition-all duration-200 hover:bg-indigo-600 hover:text-white group-hover:translate-x-1"
              >
                <span>Read article</span>
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</div>
