---
import type { PublicPost } from "@/shared/types/posts"
import type { Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"
import { safeContentHref } from "../safe-url"

interface Props {
  section: Section
  contentItems?: PublicPost[]
}

const { section, contentItems = [] } = Astro.props as Props
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <section id={section.style_id || undefined} class:list={["border border-[var(--line-strong)] bg-[var(--paper)] px-6 py-8 sm:px-10 sm:py-10", section.style_css]}>
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading content={section} theme="light" />
        <span class="shrink-0 text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">{contentItems.length} items</span>
      </div>
      <div class="grid gap-0 divide-y divide-[var(--line-strong)] border-t border-[var(--line-strong)] sm:grid-cols-2 sm:divide-y-0 sm:divide-x lg:grid-cols-3">
        {contentItems.map((post) => (
          <article class="flex flex-col justify-between p-6 sm:p-7">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--muted)]">{post.type}</p>
              <h3 class="mt-3 text-[20px] font-black leading-none tracking-[-0.03em] text-[var(--ink)]">
                <a href={safeContentHref(post.type, post.slug)} class="hover:underline decoration-2 underline-offset-4">
                  {post.title}
                </a>
              </h3>
              {post.excerpt && <p class="mt-3 line-clamp-3 text-[14px] leading-6 text-[var(--muted)]">{post.excerpt}</p>}
            </div>
            <div class="mt-6 border-t border-[var(--line)] pt-4">
              <a
                href={safeContentHref(post.type, post.slug)}
                class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--ink)] hover:gap-3"
              >
                Read article <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</div>
