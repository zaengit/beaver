---
import { getSectionStyle, safeHref, type Section } from "./shared/types"
import ResponsiveImage from "@/components/web/responsive-image.astro"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
const items = section.item ?? []
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
  {items.map((item) => (
    <section
      id={section.style_id || undefined}
      class:list={[
        "overflow-hidden border border-[var(--line-strong)] bg-[var(--paper)]",
        section.style_css
      ]}
      style={getSectionStyle({ ...section, bg_color: item.bg_color || section.bg_color, bg_image: item.bg_image || section.bg_image })}
    >
      <div class="grid lg:grid-cols-[1.05fr_0.95fr]">
        <div class:list={[
          "px-6 py-10 sm:px-10 sm:py-14 lg:px-12 lg:py-16",
          section.alignment === "center" && "text-center",
          section.alignment === "right" && "text-right"
        ]}>
          <SectionHeading content={item} theme="light" />
          {item.links?.length ? (
            <div class:list={[
              "mt-8 flex flex-wrap gap-3",
              section.alignment === "center" && "justify-center",
              section.alignment === "right" && "justify-end"
            ]}>
              {item.links.filter((link) => link.label && safeHref(link.url) !== "#").map((link, idx) => (
                <a
                  href={safeHref(link.url)}
                  class:list={[
                    "inline-flex items-center justify-center border px-6 py-3 text-[11px] font-bold uppercase tracking-[0.14em]",
                    idx === 0
                      ? "border-[var(--line-strong)] bg-[var(--ink)] text-white hover:bg-black"
                      : "border-[var(--line-strong)] bg-[var(--paper)] text-[var(--ink)] hover:bg-[var(--bg)]"
                  ]}
                >
                  {link.label}
                </a>
              ))}
            </div>
          ) : null}
          <div class="mt-8 flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--muted)]">
            <span class="h-px w-10 bg-[var(--line-strong)]"></span>
            <span>Flowstack Editorial</span>
          </div>
        </div>
        <div class="relative min-h-[280px] border-t border-[var(--line-strong)] bg-[var(--bg)] lg:min-h-[420px] lg:border-l lg:border-t-0">
          {item.image ? (
            <ResponsiveImage
              src={item.image}
              alt={item.alt_image || item.title || ""}
              class="h-full w-full object-cover"
            />
          ) : (
            <div class="flex h-full min-h-[280px] items-center justify-center p-8 text-center lg:min-h-[420px]">
              <div class="max-w-sm border border-dashed border-[var(--line)] bg-[var(--paper)] px-6 py-8">
                <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--ink)]">No cover image</p>
                <p class="mt-2 text-sm leading-6 text-[var(--muted)]">Add an image to this hero item to complete the editorial layout.</p>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}
</div>
