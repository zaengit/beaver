---
import { getSectionStyle, type Section } from "./shared/types"
import { getSafeLinks } from "../safe-url"
import ResponsiveImage from "@/components/web/responsive-image.astro"

interface Props { section: Section }
const { section } = Astro.props
const items = section.item ?? []
---

<div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24 lg:py-28">
  {items.map((item, idx) => {
    const links = getSafeLinks(item.links)

    return (
    <section id={idx === 0 ? section.style_id || undefined : undefined} class:list={["text-center", section.style_css]} style={getSectionStyle(section)}>
      {item.caption && <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#1769f5]">{item.caption}</p>}
      {item.title && <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-semibold leading-[1.08] tracking-[-0.055em] text-[#111827] sm:text-6xl lg:text-[4.25rem]">{item.title}</h1>}
      {item.text && <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-slate-500 sm:text-lg">{item.text}</p>}
      {links.length > 0 ? (
        <div class="mt-9 flex flex-wrap justify-center gap-2">
          {links.map((link, linkIdx) => (
            <a
              href={link.href}
              class:list={[
                "inline-flex items-center justify-center rounded-md px-5 py-3 text-sm font-semibold transition",
                linkIdx === 0
                  ? "bg-[#1769f5] text-white shadow-sm shadow-blue-500/20 hover:bg-[#0e58d8]"
                  : "border border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:text-slate-950"
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      ) : null}
      {item.image && (
        <div class="mx-auto mt-16 max-w-6xl rounded-2xl bg-[#edf7ff] p-4 sm:p-6 lg:mt-20">
          <div class="overflow-hidden rounded-xl border border-[#dcecf9] bg-white shadow-[0_20px_50px_-35px_rgba(23,105,245,0.35)]">
            <ResponsiveImage
              src={item.image}
              alt={item.alt_image || item.title || ""}
              class="aspect-[16/8] w-full object-cover"
            />
          </div>
        </div>
      )}
    </section>
    )
  })}
</div>
