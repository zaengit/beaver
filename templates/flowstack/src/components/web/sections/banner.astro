---
import { getSectionStyle, safeHref, type Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <section id={section.style_id || undefined} class:list={["space-y-4", section.style_css]}>
    {(section.item ?? []).map((item) => (
      <article
        class="border border-[var(--line-strong)] bg-[var(--paper)] px-6 py-8 sm:px-10 sm:py-10"
        style={getSectionStyle({ ...section, bg_color: item.bg_color || section.bg_color, bg_image: item.bg_image || section.bg_image })}
      >
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-3xl">
            <SectionHeading content={item} theme="light" />
          </div>
          {item.links?.[0]?.label && safeHref(item.links[0]?.url) !== "#" && (
            <a
              href={safeHref(item.links[0].url)}
              class="inline-flex h-11 shrink-0 items-center justify-center border border-[var(--line-strong)] bg-[var(--ink)] px-6 text-[11px] font-bold uppercase tracking-[0.14em] text-white hover:bg-black"
            >
              {item.links[0].label} →
            </a>
          )}
        </div>
      </article>
    ))}
  </section>
</div>
