---
import { getSectionStyle, type Section } from "./shared/types"
import ResponsiveImage from "@/components/web/responsive-image.astro"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 my-6">
  <section id={section.style_id || undefined} class:list={["space-y-6", section.style_css]}>
    {(section.item ?? []).map((item) => (
      <article
        class="relative isolate overflow-hidden rounded-[28px] sm:rounded-[36px] border border-indigo-500/30 bg-gradient-to-r from-slate-950 via-indigo-950 to-slate-900 p-8 sm:p-12 text-white shadow-2xl group hover:border-indigo-500/50 transition-all duration-300"
        style={getSectionStyle({ ...section, bg_color: item.bg_color || section.bg_color, bg_image: item.bg_image || section.bg_image })}
      >
        {item.image && (
          <ResponsiveImage
            src={item.image}
            alt={item.alt_image || item.title || ""}
            class="absolute inset-0 -z-20 h-full w-full object-cover opacity-35 transition-transform duration-700 group-hover:scale-105"
          />
        )}
        <div class="absolute inset-0 -z-10 bg-slate-950/60 backdrop-blur-3xs" />
        
        <div class="relative z-10 mx-auto flex max-w-7xl flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="max-w-3xl">
            <SectionHeading content={item} theme="dark" />
          </div>
          {item.links?.[0]?.label && item.links[0]?.url && (
            <a
              href={item.links[0].url}
              class="shrink-0 rounded-full bg-white px-7 py-3.5 text-sm font-bold text-slate-950 shadow-lg transition-all duration-200 hover:bg-indigo-50 hover:scale-105 active:scale-95 inline-flex items-center gap-2"
            >
              <span>{item.links[0].label}</span>
              <svg class="h-4 w-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          )}
        </div>
      </article>
    ))}
  </section>
</div>
