---
import type { ArchiveProps } from "../types";
import ResponsiveImage from "@/components/web/responsive-image.astro";
import ArchiveFilters from "./archive-filters.astro";
import ArchivePagination from "./archive-pagination.astro";
import { safeContentHref } from "../../safe-url";
const { contentType, posts, filterOptions, filters, pagination } = Astro.props as ArchiveProps;
---

<main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-12">
  <header class="border-b-[3px] border-[var(--line-strong)] pb-8">
    <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]">{contentType.slug} — archive</p>
    <h1 class="mt-3 max-w-3xl text-[36px] font-black leading-none tracking-[-0.04em] text-[var(--ink)] sm:text-[56px]">
      {contentType.label}
    </h1>
    {contentType.description && (
      <p class="mt-4 max-w-2xl text-[15px] leading-7 text-[var(--muted)]">
        {contentType.description}
      </p>
    )}
  </header>

  <ArchiveFilters {contentType} {filterOptions} {filters} />

  <div class="mt-8 grid gap-0 divide-y divide-[var(--line-strong)] border-y border-[var(--line-strong)] sm:grid-cols-2 sm:divide-y-0 sm:divide-x lg:grid-cols-3">
    {posts.map((post) => (
      <article class="flex flex-col justify-between bg-[var(--paper)] p-6 sm:p-7">
        <div>
          {post.featuredImage && (
            <div class="overflow-hidden border border-[var(--line)]">
              <ResponsiveImage
                src={post.featuredImage}
                alt={post.title}
                class="aspect-[4/3] w-full object-cover"
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              />
            </div>
          )}
          <div class="pt-4">
            <h2 class="text-[18px] font-black leading-tight tracking-[-0.03em] text-[var(--ink)]">
              <a href={safeContentHref(contentType.slug, post.slug)} class="hover:underline decoration-2 underline-offset-4">
                {post.title}
              </a>
            </h2>
            {post.excerpt && (
              <p class="mt-2 line-clamp-3 text-[14px] leading-6 text-[var(--muted)]">{post.excerpt}</p>
            )}
          </div>
        </div>
        <div class="mt-6 border-t border-[var(--line)] pt-4">
          <a
            href={safeContentHref(contentType.slug, post.slug)}
            class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--ink)]"
          >
            View details <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>

  {posts.length === 0 && (
    <div class="mt-8 border border-dashed border-[var(--line)] bg-[var(--paper)] p-8 text-center">
      <p class="text-sm font-semibold text-[var(--muted)]">
        No published {contentType.label.toLowerCase()} yet.
      </p>
    </div>
  )}

  <ArchivePagination {filters} {pagination} />
</main>
