---
import type { PublicArchiveFilters } from "@/shared/types/posts";

const { filters, pagination } = Astro.props as {
  filters: PublicArchiveFilters;
  pagination: { currentPage: number; lastPage: number };
};

function pageUrl(page: number) {
  const query = new URLSearchParams();
  if (page > 1) query.set("page", String(page));
  if (filters.search) query.set("search", filters.search);
  if (filters.category) query.set("category", filters.category);
  if (filters.tag) query.set("tag", filters.tag);
  for (const [name, value] of Object.entries(filters.customFields ?? {})) {
    query.set(`field_${name}`, value);
  }
  const search = query.toString();
  return search ? `?${search}` : "?";
}
---

{
  pagination.lastPage > 1 && (
    <nav class="mt-12 flex items-center justify-center gap-3" aria-label="Archive pagination">
      {pagination.currentPage > 1 && (
        <a
          href={pageUrl(pagination.currentPage - 1)}
          class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-xs transition-all duration-200 hover:border-indigo-600 hover:bg-indigo-600 hover:text-white active:scale-95 inline-flex items-center gap-2"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          <span>Previous</span>
        </a>
      )}
      <span class="rounded-full bg-slate-100 border border-slate-200/90 px-4 py-2 text-xs font-bold text-slate-600">
        Page {pagination.currentPage} of {pagination.lastPage}
      </span>
      {pagination.currentPage < pagination.lastPage && (
        <a
          href={pageUrl(pagination.currentPage + 1)}
          class="rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 shadow-xs transition-all duration-200 hover:border-indigo-600 hover:bg-indigo-600 hover:text-white active:scale-95 inline-flex items-center gap-2"
        >
          <span>Next</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      )}
    </nav>
  )
}
