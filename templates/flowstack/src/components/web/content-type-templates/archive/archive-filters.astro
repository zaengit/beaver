---
import type { PublicArchiveFilterOptions, PublicArchiveFilters } from "@/shared/types/posts"
import { safeContentArchiveHref } from "../../safe-url"
import { getArchiveSortValue } from "./archive-sort"

interface Props {
  contentType: { slug: string }
  filterOptions: PublicArchiveFilterOptions
  filters: PublicArchiveFilters
}

const { contentType, filterOptions, filters } = Astro.props
const sortValue = getArchiveSortValue(filters)
const isFiltered = Boolean(filters.search || filters.category || sortValue !== "newest")
const fieldClass = "w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm font-medium text-slate-800 outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-500/10"
const labelClass = "mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-slate-500"
---

<form action={safeContentArchiveHref(contentType.slug)} method="get" class="mt-8 border-y border-slate-200 py-5 sm:py-6">
  <div class="grid gap-4 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <label class={labelClass} for="archive-search">Search</label>
      <input
        id="archive-search"
        name="search"
        value={filters.search ?? ""}
        type="search"
        placeholder="Search..."
        class={fieldClass}
      />
    </div>
    <div>
      <label class={labelClass} for="archive-category">Category</label>
      <select id="archive-category" name="category" class={fieldClass}>
        <option value="">All categories</option>
        {filterOptions.categories.map((category) => <option value={category.slug} selected={filters.category === category.slug}>{category.name}</option>)}
      </select>
    </div>
    <div>
      <label class={labelClass} for="archive-sort">Sort</label>
      <select id="archive-sort" name="sort" class={fieldClass}>
        <option value="newest" selected={sortValue === "newest"}>Newest first</option>
        <option value="oldest" selected={sortValue === "oldest"}>Oldest first</option>
        <option value="title-asc" selected={sortValue === "title-asc"}>Title A–Z</option>
        <option value="title-desc" selected={sortValue === "title-desc"}>Title Z–A</option>
      </select>
    </div>
  </div>
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <button class="group inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-3 text-xs font-bold text-white shadow-lg shadow-indigo-600/20 transition hover:-translate-y-0.5 hover:bg-indigo-700">
      Apply filters <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </button>
    {isFiltered && (
      <a href={safeContentArchiveHref(contentType.slug)} class="rounded-xl border border-slate-200 bg-white px-5 py-3 text-xs font-bold text-slate-700 transition hover:border-indigo-200 hover:text-indigo-700">
        Clear
      </a>
    )}
  </div>
</form>
