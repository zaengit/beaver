---
import { parseGallery, type DetailProps } from "../types";
import ResponsiveImage from "@/components/web/responsive-image.astro";
import TagLinks from "@/components/web/tag-links.astro";
import { sanitizeHtml } from "@zbeaver/beaver/server";
import { safeContentArchiveHref } from "../../safe-url";
const { contentType, post } = Astro.props as DetailProps;
const gallery = parseGallery(post.gallery);
---

<main class="mx-auto max-w-3xl px-4 sm:px-6 py-10 sm:py-12">
  <a
    href={safeContentArchiveHref(contentType.slug)}
    class="inline-flex items-center gap-2 border border-[var(--line-strong)] bg-[var(--paper)] px-4 py-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--ink)] hover:bg-[var(--bg)]"
  >
    ← All {contentType.label}
  </a>

  <article class="mt-8">
    <header class="border-b border-[var(--line-strong)] pb-8">
      <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--muted)]">{contentType.label}</p>
      <h1 class="mt-3 text-[36px] font-black leading-none tracking-[-0.04em] text-[var(--ink)] sm:text-[52px]">
        {post.title}
      </h1>
      {post.excerpt && (
        <p class="mt-4 text-[16px] leading-7 text-[var(--muted)]">{post.excerpt}</p>
      )}
      {post.authorName && (
        <div class="mt-4 inline-flex items-center gap-2 border border-[var(--line)] bg-[var(--paper)] px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.12em] text-[var(--ink)]">
          <span class="h-2 w-2 bg-[var(--ink)]" aria-hidden="true"></span>
          <span>By {post.authorName}</span>
        </div>
      )}
    </header>

    <TagLinks tags={post.tags} />

    {post.featuredImage && (
      <div class="mt-8 overflow-hidden border border-[var(--line-strong)] bg-[var(--paper)]">
        <ResponsiveImage
          src={post.featuredImage}
          alt={post.title}
          class="max-h-[32rem] w-full object-cover"
        />
      </div>
    )}

    {post.description && (
      <div
        id="details"
        class="prose prose-slate prose-lg mt-8 max-w-none border border-[var(--line)] bg-[var(--paper)] p-6 prose-headings:font-black prose-a:text-[var(--ink)] prose-a:underline sm:p-8"
        set:html={sanitizeHtml(post.description)}
      />
    )}

    {gallery.length > 0 && (
      <div class="mt-8 grid gap-4 border-t border-[var(--line-strong)] pt-8 sm:grid-cols-2">
        {gallery.map((image) => (
          <div class="overflow-hidden border border-[var(--line-strong)] bg-[var(--paper)]">
            <ResponsiveImage
              src={image}
              alt=""
              class="w-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    )}
  </article>
</main>
