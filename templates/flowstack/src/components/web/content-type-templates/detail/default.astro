---
import { parseGallery, type DetailProps } from "../types";
import ResponsiveImage from "@/components/web/responsive-image.astro";
import TagLinks from "@/components/web/tag-links.astro";
const { contentType, post } = Astro.props as DetailProps;
const gallery = parseGallery(post.gallery);
---

<main class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
  <a
    href={`/${contentType.slug}`}
    class="inline-flex items-center gap-2 rounded-full bg-slate-100 border border-slate-200 px-4 py-2 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 hover:border-indigo-200 transition-all duration-200 active:scale-95"
  >
    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
    </svg>
    <span>All {contentType.label}</span>
  </a>

  <article class="mt-8">
    <header class="max-w-3xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-indigo-700 shadow-2xs mb-3">
        <span class="h-1.5 w-1.5 rounded-full bg-indigo-600"></span>
        {contentType.label}
      </span>
      <h1 class="text-4xl font-extrabold tracking-tight text-slate-950 sm:text-6xl leading-[1.15]">
        {post.title}
      </h1>
      {post.excerpt && (
        <p class="mt-5 text-lg leading-relaxed text-slate-600 font-normal">{post.excerpt}</p>
      )}
    </header>

    <TagLinks tags={post.tags} />

    {post.featuredImage && (
      <div class="mt-10 overflow-hidden rounded-[28px] border border-slate-200 shadow-xl">
        <ResponsiveImage
          src={post.featuredImage}
          alt={post.title}
          class="max-h-[32rem] w-full object-cover"
          priority
        />
      </div>
    )}

    {post.description && (
      <div
        id="details"
        class="prose prose-slate mt-10 max-w-none prose-headings:font-bold prose-a:text-indigo-600 prose-img:rounded-[24px]"
        set:html={post.description}
      />
    )}

    {gallery.length > 0 && (
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {gallery.map((image) => (
          <div class="overflow-hidden rounded-[24px] border border-slate-200/90 shadow-md transition-all duration-300 hover:shadow-xl hover:scale-[1.02]">
            <ResponsiveImage
              src={image}
              alt=""
              class="w-full object-cover"
              sizes="(min-width: 640px) 50vw, 100vw"
            />
          </div>
        ))}
      </div>
    )}
  </article>
</main>
