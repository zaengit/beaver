---
import type { PaginationMeta, PublicArchiveFilterOptions, PublicArchiveFilters, PublicPost } from "@/shared/types"
import { getArchiveTemplateComponent } from "@/components/web/content-type-templates/component-resolver"

interface Props {
  contentType: { label: string; description: string | null; slug: string; archiveTemplate: string }
  posts: PublicPost[]
  filterOptions: PublicArchiveFilterOptions
  filters: PublicArchiveFilters
  pagination: PaginationMeta
}

const { contentType, posts, filterOptions, filters, pagination } = Astro.props
const Template = getArchiveTemplateComponent(contentType.archiveTemplate)
---

<Template {contentType} {posts} {filterOptions} {filters} {pagination} />
