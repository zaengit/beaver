---
import { existsSync } from "node:fs"
import { join } from "node:path"
import { safeImageSrc } from "./safe-url"

interface Props {
  src: string
  alt: string
  class?: string
  loading?: "eager" | "lazy"
  priority?: boolean
  sizes?: string
}

const { src, alt, class: className, loading = "lazy", priority = false, sizes = "100vw" } = Astro.props
const safeSrc = safeImageSrc(src)
const uploadMatch = safeSrc?.match(/^\/(uploads\/\d{4}\/\d{2}\/[A-Za-z0-9-]+)\.[A-Za-z0-9]+$/)
const variants = uploadMatch
  ? [640, 1280]
      .map((width) => ({ width, url: `/${uploadMatch[1]}_w${width}.webp` }))
      .filter(({ url }) => existsSync(join(process.cwd(), "public", url)))
  : []
const srcset = variants.length > 1 ? variants.map(({ width, url }) => `${url} ${width}w`).join(", ") : undefined
---

{safeSrc && (
  <img
    src={safeSrc}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    alt={alt}
    class={className}
    loading={priority ? "eager" : loading}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
  />
)}
