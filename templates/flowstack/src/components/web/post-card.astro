---
import type { PublicPost } from "@/shared/types/posts"
import ResponsiveImage from "@/components/web/responsive-image.astro"

type PostCardVariant = "default" | "post-grid" | "section"

interface Props {
  post: PublicPost
  href: string
  variant: PostCardVariant
}

const { post, href, variant } = Astro.props
const gridStyles = {
  article: "flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_18px_50px_-40px_rgba(15,23,42,0.45)] transition duration-200 hover:-translate-y-1 hover:shadow-xl hover:shadow-indigo-950/5",
  imageWrapper: "overflow-hidden border-b border-slate-200",
  image: "aspect-[16/10] w-full object-cover transition duration-500 hover:scale-105",
  content: "p-6 sm:p-7",
  title: "text-xl font-bold leading-tight tracking-[-0.03em] text-slate-950",
  titleLink: "hover:text-indigo-700 hover:underline decoration-2 underline-offset-4",
  excerpt: "mt-3 line-clamp-3 text-sm leading-6 text-slate-600",
  footer: "border-t border-slate-200 px-6 py-4 sm:px-7",
  action: "inline-flex items-center gap-2 text-xs font-bold text-indigo-700 hover:gap-3 hover:text-indigo-950",
  actionLabel: "Read article",
  actionIcon: "↗",
} as const
const styles = {
  default: {
    article: "flex flex-col justify-between bg-[var(--paper)] p-6 sm:p-7",
    imageWrapper: "overflow-hidden border border-[var(--line)]",
    image: "aspect-[4/3] w-full object-cover",
    content: "pt-4",
    title: "text-[18px] font-black leading-tight tracking-[-0.03em] text-[var(--ink)]",
    titleLink: "hover:underline decoration-2 underline-offset-4",
    excerpt: "mt-2 line-clamp-3 text-[14px] leading-6 text-[var(--muted)]",
    footer: "mt-6 border-t border-[var(--line)] pt-4",
    action: "inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--ink)]",
    actionLabel: "View details",
    actionIcon: "→",
  },
  "post-grid": gridStyles,
  section: {
    ...gridStyles,
    article: "flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-slate-50/70 transition duration-200 hover:-translate-y-1 hover:bg-white hover:shadow-lg hover:shadow-indigo-950/5",
    title: "mt-3 text-xl font-bold leading-tight tracking-[-0.03em] text-slate-950",
    titleLink: "hover:underline decoration-2 underline-offset-4",
  },
} as const
const style = styles[variant]
---

<article class={style.article}>
  <div>
    {post.featuredImage && (
      <div class={style.imageWrapper}>
        <ResponsiveImage
          src={post.featuredImage}
          alt={post.title}
          class={style.image}
          loading={variant === "default" ? undefined : "lazy"}
          sizes={variant === "default" ? "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" : undefined}
        />
      </div>
    )}
    <div class={style.content}>
      {variant === "section" ? (
        <h3 class={style.title}><a href={href} class={style.titleLink}>{post.title}</a></h3>
      ) : (
        <h2 class={style.title}><a href={href} class={style.titleLink}>{post.title}</a></h2>
      )}
      {post.excerpt && <p class={style.excerpt}>{post.excerpt}</p>}
    </div>
  </div>
  <div class={style.footer}>
    <a href={href} class={style.action}>
      {style.actionLabel} <span aria-hidden="true">{style.actionIcon}</span>
    </a>
  </div>
</article>
