---
import { getSafeLinks } from "../safe-url"
import { getSectionStyle, type Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
  <section id={section.style_id || undefined} class:list={["text-center", section.style_css]} style={getSectionStyle(section)}>
    {(section.caption || section.title || section.text) && <SectionHeading content={section} theme="light" />}
    <div class="mt-10 grid gap-8 border-y border-slate-100 py-8 md:grid-cols-3 md:gap-0 md:divide-x md:divide-slate-100 md:py-7">
      {(section.item ?? []).map((item) => {
        const link = getSafeLinks(item.links)[0]

        return (
          <article class="px-4 text-center sm:px-8">
            {item.icon && <span class="mx-auto mb-4 inline-flex h-8 min-w-8 items-center justify-center rounded-full bg-blue-50 px-2 text-[10px] font-bold uppercase tracking-[0.08em] text-[#1769f5]">{item.icon}</span>}
            {item.title && <h3 class="text-base font-bold leading-6 text-slate-800">{item.title}</h3>}
            {item.text && <p class="mt-1.5 text-sm leading-6 text-slate-500">{item.text}</p>}
            {link && <a href={link.href} class="mt-3 inline-flex text-sm font-semibold text-[#1769f5] hover:underline">{link.label}</a>}
          </article>
        )
      })}
    </div>
  </section>
</div>
