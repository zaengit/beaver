{
  "name": "@zbeaver/beaver",
  "version": "0.1.17",
  "description": "CMS admin panel, API, and middleware for Astro SSR projects.",
  "license": "MIT",
  "keywords": [
    "astro-integration",
    "withastro",
    "cms",
    "content-management",
    "admin-panel",
    "astro-ssr"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaengit/beaver.git"
  },
  "homepage": "https://github.com/zaengit/beaver#readme",
  "bugs": {
    "url": "https://github.com/zaengit/beaver/issues"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "beaver": "bin/beaver.mjs"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "tsx": {
      "esbuild": "0.28.2"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./ui/admin.css": "./dist/ui/admin.css",
    "./ui/admin-layout.astro": "./dist/ui/admin-layout.astro",
    "./astro/admin.astro": "./dist/astro/admin.astro"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.0",
    "astro": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-character-count": "^3.23.4",
    "@tiptap/extension-code-block-lowlight": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/extension-youtube": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "jose": "^6.2.3",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.14.0",
    "mysql2": "^3.14.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "react-router": "^8.3.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "ulidx": "^2.4.1",
    "use-sync-external-store": "^1.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "shadcn": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.5"
  }
}
