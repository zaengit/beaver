---
import type { Section, SectionItem } from "./types"

interface Props {
  content: Pick<Section | SectionItem, "caption" | "title" | "text">
}

const { content } = Astro.props
---

{content.caption && <p class="text-sm font-semibold text-indigo-400">{content.caption}</p>}
{content.title && <h2 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{content.title}</h2>}
{content.text && <p class="mt-5 max-w-3xl leading-7 text-slate-300">{content.text}</p>}
