---
import { getSectionStyle, type Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section }
const { section } = Astro.props
---

<section id={section.style_id || undefined} class:list={["bg-slate-950 py-20 text-white sm:py-28", section.style_css]} style={getSectionStyle(section)}>
  <div class="mx-auto max-w-4xl px-6">
    <SectionHeading content={section} />
    <div class="mt-10 divide-y divide-slate-700 border-y border-slate-700">
      {(section.item ?? []).map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-semibold"><span>{item.question}</span><span class="text-xl group-open:hidden">+</span><span class="hidden text-xl group-open:inline">−</span></summary>
          {item.answer && <p class="mt-4 max-w-3xl whitespace-pre-line leading-7 text-slate-300">{item.answer}</p>}
        </details>
      ))}
    </div>
  </div>
</section>
