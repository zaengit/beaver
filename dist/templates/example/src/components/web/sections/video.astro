---
import type { Section } from "./shared/types"
import SectionHeading from "./shared/section-heading.astro"

interface Props { section: Section; videoEmbedUrl: string | null }
const { section, videoEmbedUrl } = Astro.props
---

<section id={section.style_id || undefined} class:list={["border-b border-slate-100", section.style_css]}>
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-20">
    <SectionHeading content={section} />
    {videoEmbedUrl && <div class="mt-10 aspect-video max-w-5xl overflow-hidden rounded-sm bg-slate-950 shadow-xl"><iframe class="h-full w-full" src={videoEmbedUrl} title={section.title || "Video"} allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen /></div>}
  </div>
</section>
