---
interface Props {
  tags: string | null
}

const { tags } = Astro.props
let parsedTags: string[] = []

try {
  const value = tags ? JSON.parse(tags) : []
  if (Array.isArray(value)) {
    parsedTags = [...new Set(value.filter((tag): tag is string => typeof tag === "string").map((tag) => tag.trim()).filter(Boolean))]
  }
} catch {
  // A malformed legacy value should not prevent a public page from rendering.
}
---

{parsedTags.length > 0 && (
  <nav class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
    {parsedTags.map((tag) => (
      <a href={`/tag/${encodeURIComponent(tag)}`} class="border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-600 hover:border-slate-400 hover:text-slate-950">
        {tag}
      </a>
    ))}
  </nav>
)}
