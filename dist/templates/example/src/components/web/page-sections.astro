---
import { toVideoEmbedUrl, type Section } from "./sections/shared/types"
import ContactSection from "./sections/contact"
import sectionTemplates from "@section-registry"
import { listPublishedPostsByType } from "@zaenpm/zadm/server"

interface Props { sections: string | null }

const { sections } = Astro.props
const sectionComponents = Object.fromEntries(
  Object.entries(import.meta.glob("./sections/*.astro", { eager: true })).map(([path, module]) => [
    path.replace("./sections/", "").replace(/\.astro$/, ""),
    (module as { default: unknown }).default,
  ]),
) as Record<string, any>

let parsedSections: Section[] = []
try {
  const parsed = sections ? JSON.parse(sections) : []
  parsedSections = Array.isArray(parsed) ? parsed : []
} catch { /* Invalid stored JSON is rendered as no sections. */ }

const renderedSections = parsedSections.flatMap((section) => {
  const template = sectionTemplates.find((candidate) => candidate.type === section.type)
  if (!template) return []
  const contentItemsResult = template.contentType
    ? listPublishedPostsByType(template.contentType, 1, section.limit && section.limit > 0 ? section.limit : 12, { category: section.category || undefined, sortBy: section.sort_by === "title" ? "title" : "created_at", sortOrder: section.sort_order === "asc" ? "asc" : "desc" })
    : null
  const firstItem = section.item?.[0]
  return [{
    section,
    template,
    contentItems: contentItemsResult?.success ? contentItemsResult.data.data : [],
    videoEmbedUrl: toVideoEmbedUrl(firstItem?.video),
    mapCoordinate: typeof firstItem?.map === "string" ? firstItem.map.trim() : null,
    hasInquiryForm: section.item?.some((item) => item.form_inquiry === true) ?? false,
  }]
})
---

{renderedSections.map(({ section, template, contentItems, videoEmbedUrl, mapCoordinate, hasInquiryForm }) => {
  if (section.type === "contact") {
    return <ContactSection client:visible {section} {contentItems} {videoEmbedUrl} {mapCoordinate} {hasInquiryForm} />
  }

  const SectionComponent = sectionComponents[template.type]

  if (!SectionComponent) return null

  return <SectionComponent {section} {contentItems} {videoEmbedUrl} {mapCoordinate} {hasInquiryForm} />
})}
